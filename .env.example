# ScopeLock AI — Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Relative to the directory where the backend process runs.
# In the workspace monorepo that is the repo root, so dev.db is at the root.
DATABASE_PATH=./dev.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for production.
# In development, all localhost origins are automatically allowed.
FRONTEND_ORIGIN=http://localhost:5174,https://scope-lock-ai-7u5i.vercel.app

# ── Demo Identity ─────────────────────────────────────────────────────────────
# Set to "true" to enable the x-demo-user-id header for identity switching.
# IMPORTANT: This is NOT production authentication. Never enable in a real deployment.
ENABLE_DEMO_IDENTITY=true

# ── AI Provider ──────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT with Ollama:
#   1. Install Ollama: https://ollama.ai
#   2. Pull the model: ollama pull llama3.2:3b
#   3. Start Ollama (runs automatically on macOS after install)
#   4. Set the vars below and start the backend.
#
# HOSTED DEPLOYMENT (Render):
#   Replace AI_BASE_URL with a compatible hosted inference endpoint.
#   Options: Together AI, Groq, OpenRouter, Anyscale, or a self-hosted vLLM instance.
#   Set AI_API_KEY to the bearer token for the hosted provider.
#   The Ollama /api/chat format is NOT identical to OpenAI /v1/chat/completions —
#   use AI_PROVIDER=openai-compat for OpenAI-compatible endpoints.
#
# LEAVE EMPTY to run without AI (frontend shows "model unavailable" state).

# Supported: "ollama" | "openai-compat" | "" (empty = disabled)
AI_PROVIDER=ollama

# Model name as registered in Ollama or the hosted provider.
# Llama 3.2 3B (MIT license) is the default for local development.
# See: https://ollama.com/library/llama3.2
AI_MODEL=llama3.2:3b

# Inference endpoint base URL.
# Ollama default: http://localhost:11434
# NOTE: http://localhost:11434 does NOT work on Render — use a hosted endpoint.
AI_BASE_URL=http://localhost:11434

# API key for hosted providers. Leave empty for local Ollama (no auth required).
# NEVER commit this value. Set it as a secret in Render's environment panel.
AI_API_KEY=

# Request timeout in milliseconds (default: 30000).
AI_TIMEOUT_MS=30000
